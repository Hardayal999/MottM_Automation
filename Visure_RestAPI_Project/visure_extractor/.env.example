# =============================================================================
# Visure API Extractor — Credentials & Configuration
# =============================================================================
# COPY this file to .env  (just the filename, no extension)
# Fill in your real values.
# NEVER commit .env to git. The .gitignore in this folder already excludes it.
# =============================================================================

# Your Visure login (the same username you use to log into the web UI)
VISURE_USERNAME=your.username

# Your Visure password
VISURE_PASSWORD=your_password_here

# Base URL of your Visure instance — no trailing slash
VISURE_BASE_URL=https://mottmac.visurecloud.com/VisureAuthoring8

# Where the Excel output should land (relative or absolute path).
# Default: ./output/  inside the project folder
OUTPUT_DIR=./output

# License type to request when authenticating.
# AUTHORING is the standard one. Don't change unless your admin tells you to.
LICENSE_TYPE=AUTHORING
